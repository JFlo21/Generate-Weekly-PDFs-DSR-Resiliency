+FORMULA_ERROR_VALUES = frozenset({
+    '#BLOCKED',
+    '#CALCULATING',
+    '#CIRCULAR REFERENCE',
+    '#INVALID COLUMN VALUE',
+    '#INVALID DATA TYPE',
+    '#INVALID OPERATION',
+    '#INVALID REF',
+    '#INVALID VALUE',
+    '#NO MATCH',
+    '#REF',
+    '#UNPARSEABLE',
+})
+
+HELPER_VARIANTS = frozenset({
+    'helper',
+    'helper2',
+    'aep_billable_helper',
+    'aep_billable_helper2',
+    'reduced_sub_helper',
+    'reduced_sub_helper2',
+})
+
+HELPER2_VARIANTS = frozenset({
+    'helper2',
+    'aep_billable_helper2',
+    'reduced_sub_helper2',
+})
+
+
+def normalize_helper_value(value: object) -> str:
+    """Return a safe helper value, treating Smartsheet errors as blank."""
+    if value is None:
+        return ''
+    normalized = str(value).strip()
+    if normalized.upper() in FORMULA_ERROR_VALUES:
+        return ''
+    return normalized
+
+
+def extract_contact_emails(
+    object_value: object,
+    fallback: object = None,
+) -> str:
+    """Extract email addresses from a Smartsheet contact object value."""
+    if object_value is None:
+        return normalize_helper_value(fallback)
+    if isinstance(object_value, dict):
+        contacts = object_value.get('values') or [object_value]
+    else:
+        contacts = getattr(object_value, 'values', None) or [object_value]
+    emails: list[str] = []
+    for contact in contacts:
+        email = (
+            contact.get('email')
+            if isinstance(contact, dict)
+            else getattr(contact, 'email', None)
+        )
+        normalized = normalize_helper_value(email)
+        if normalized and normalized not in emails:
+            emails.append(normalized)
+    return '; '.join(emails) or normalize_helper_value(fallback)
+
+
+@dataclass(frozen=True)
+class HelperAssignment:
+    """Normalized metadata for one helper role on a source row."""
+
+    role: Literal[1, 2]
+    foreman: str
+    email: str
+    department: str
+    job: str
+    completed: bool
+
+    @property
+    def is_valid(self) -> bool:
+        """Match production Helper #1 validity: foreman and dept required."""
+        return bool(self.completed and self.foreman and self.department)
+
+
+class HelperAssignmentConflictError(RuntimeError):
+    """Raised when one unit is completed by both helper roles."""
 
 if TYPE_CHECKING:  # pragma: no cover - reserved for future shared shapes
